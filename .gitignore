# session_activate.js / session_log.js 这三个源码文件一起挡在库外。
*_session.json
*session[0-9]*.json
hs_session.json
hs_admin_session.json
lousao_session.json
ues_session.json
aidsc_session.json
ltb_session.json
apt_session*.json
anheng_cloud_session.json
*_cookies.json
*cookie*.json

